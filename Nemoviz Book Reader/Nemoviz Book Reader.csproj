  <!-- Compile the 32-bit SAPI5 host (TtsHost32.cs) into the output as a separate
       x86 exe. It is deliberately NOT in the main (x64) Compile set; the x64 app
       launches it out-of-process to reach 32-bit-only voices (eSpeak/RHVoice).
       SapiWavPlayer.cs is shared with the main app (both play rendered speech
       through SAPI so it follows the chosen sound card); Microsoft.CSharp is
       needed because both drive SAPI through late-bound `dynamic`. -->
  <Target Name="BuildTtsHost32" AfterTargets="Build">
    <Exec Command="&quot;$(MSBuildToolsPath)\Roslyn\csc.exe&quot; /nologo /platform:x86 /target:exe /out:&quot;$(OutDir)TtsHost32.exe&quot; /r:&quot;$(FrameworkPathOverride)\Microsoft.CSharp.dll&quot; &quot;$(ProjectDir)TtsHost32.cs&quot; &quot;$(ProjectDir)SapiWavPlayer.cs&quot;" />
  </Target>
